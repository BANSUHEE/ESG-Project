<!-- 상단 네비게이션 바의 높이만큼 여백 추가 -->
<div style="margin-top: 76px;"></div>

<style>
.navbar {
    padding: 10px 0;
}

.navbar-brand {
    font-weight: bold;
    color: #28a745 !important;
}

.nav-link {
    color: #495057 !important;
    font-weight: 500;
}

.nav-link:hover {
    color: #28a745 !important;
}

#welcome {
    color: #28a745 !important;
    font-weight: bold;
}
</style>

<script>
    // sessionStorage에서 username 가져오기
    const username = sessionStorage.getItem("username");

    if (username) {
        // 로그인 상태
        $("#login, #join").hide(); // 로그인/회원가입 링크 숨기기
        $("#logout").show(); // 로그아웃 링크 표시
        $("#calculator, #record").show(); // 계산기, 기록장 링크 표시
        $("#welcome").text(username + "님 환영합니다!"); // 환영 메시지 표시
    } else {
        // 로그아웃 상태
        $("#login, #join").show(); // 로그인/회원가입 링크 표시
        $("#logout, #welcome").hide(); // 로그아웃 링크 숨기기
        $("#calculator, #record").hide(); // 계산기, 기록장 링크 숨기기
    }

    // 로그아웃 버튼 클릭 이벤트
    $("#logout").on("click", function (e) {
        e.preventDefault();
        if (!confirm("정말로 로그아웃하시겠습니까?")) return;
        sessionStorage.clear();
        location.href = "/";
    });
</script>