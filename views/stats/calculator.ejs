<style>
    .title-wrapper{
        overflow: hidden;
        text-align: center;
        }
    .title {
        margin-bottom: 20px;
        color: #3b7c4c;
        font-weight: bold;
    }
    select {
        margin-bottom: 20px;
        border: 1px solid #3b7c4c;
        border-radius: 10px;
        padding: 5px 10px;
        margin-right: 5px;
        font-size: 20px;
        font-weight: bold;
        color: #49794a;
        text-align: center;
    }

   
    .total-section {
        text-align: center; /* 전체 중앙 정렬 */
        width: 100%;
    }

    .wrapper {
        display: inline-flex; /* h3 태그를 가로로 정렬 */
        justify-content: center; /* 가로 중앙 정렬 */
        align-items: center; /* 세로 정렬 */
        gap: 10px; /* h3 태그 간 간격 */
        margin-bottom: 20px; /* 버튼과 간격 */
    }

    .total-section h3 {
        font-size: 30px;
        color: #3b7c4c;
        margin: 0;
    }

    .button {
        display: block; /* 버튼을 줄바꿈 */
        width: 220px;
        height: 50px;
        margin: 0 auto; /* 버튼을 가로 중앙 정렬 */
    }
</style>
<div class="title-wrapper">

    <h2 class="title">온실가스 계산기</h2>
    <!-- 년도 선택 -->
    <select id="yearSelect">
        <% for (let year = 2020; year <= 2030; year++) { %>
            <option value="<%= year %>" <%= year == selectedYear ? "selected" : "" %>>
                <%= year %>년
            </option>
            <% } %>
        </select>
        <select id="monthSelect">
            <% for (let month = 1; month <= 12; month++) { %>
            <option value="<%= month %>" <%= month == selectedMonth ? "selected" : "" %>>
                <%= month %>월
            </option>
            <% } %>
        </select>
    </div>



<br />

<div class="calculator">
    <!-- 전기 섹션 -->
    <div class="section bg-light p-3 mb-4 rounded">
        <h2>전기</h2>
        <label for="electricity-usage">전기 사용량 (kwh/월)</label>
        <div class="input-group">
            <input
                type="number"
                id="electricity-usage"
                class="form-control"
                placeholder="숫자 입력..."
            />
        </div>
        <p>CO₂ 발생량: <span id="electricity-co2">0.00</span> kg/월</p>
    </div>

    <!-- 가스 섹션 -->
    <div class="section bg-light p-3 mb-4 rounded">
        <h2>가스</h2>
        <label for="gas-usage">가스 사용량 (m³/월)</label>
        <div class="input-group">
            <input
                type="number"
                id="gas-usage"
                class="form-control"
                placeholder="숫자 입력..."
            />
        </div>
        <p>CO₂ 발생량: <span id="gas-co2">0.00</span> kg/월</p>
    </div>

    <!-- 수도 섹션 -->
    <div class="section bg-light p-3 mb-4 rounded">
        <h2>수도</h2>
        <label for="water-usage">수도 사용량 (m³/월)</label>
        <div class="input-group">
            <input
                type="number"
                id="water-usage"
                class="form-control"
                placeholder="숫자 입력..."
            />
        </div>
        <p>CO₂ 발생량: <span id="water-co2">0.00</span> kg/월</p>
    </div>

    <!-- 교통 섹션 -->
    <div class="section bg-light p-3 mb-4 rounded">
        <h2>교통</h2>
        <label>승용차 종류</label>
        <div class="form-check form-check-inline">
            <input
                type="radio"
                name="carType"
                value="휘발유"
                id="petrol"
                class="form-check-input"
                checked
            />
            <label class="form-check-label" for="petrol">휘발유</label>
        </div>
        <div class="form-check form-check-inline">
            <input
                type="radio"
                name="carType"
                value="경유"
                id="diesel"
                class="form-check-input"
            />
            <label class="form-check-label" for="diesel">경유</label>
        </div>
        <div class="form-check form-check-inline">
            <input
                type="radio"
                name="carType"
                value="LPG"
                id="lpg"
                class="form-check-input"
            />
            <label class="form-check-label" for="lpg">LPG</label>
        </div>
        <label for="distance">이동거리 (km/월)</label>
        <div class="input-group">
            <input
                type="number"
                id="distance"
                class="form-control"
                placeholder="숫자 입력..."
            />
        </div>
        <p>CO₂ 발생량: <span id="transport-co2">0.00</span> kg/월</p>
    </div>

    <!-- 폐기물 섹션 -->
    <div class="section bg-light p-3 mb-4 rounded">
        <h2>폐기물</h2>
        <label for="waste-type">폐기물 종류</label>
        <select id="waste-type" class="form-select mb-3">
            <option value="생활 폐기물">생활 폐기물</option>
            <option value="산업 폐기물">산업 폐기물</option>
        </select>
        <label for="waste-amount">폐기물 사용량 (L/월)</label>
        <div class="input-group">
            <input
                type="number"
                id="waste-amount"
                class="form-control"
                placeholder="숫자 입력..."
            />
        </div>
        <p>CO₂ 발생량: <span id="waste-co2">0.00</span> kg/월</p>
    </div>

    <!-- CO₂ 총량 카드 -->
    <div class="total-section">
        <!-- h3 태그 가로 정렬 -->
        <div class="wrapper">
            <h3>총 배출량</h3>
            <h3 id="totalCo2" style="font-weight: bolder;">0</h3>
            <h3>kg</h3>
        </div>
        <!-- 버튼은 줄바꿈 후 중앙 정렬 -->
        <button class="btn btn-success button" id="saveButton">저장하기</button>
    </div>
</div>

<script src="/javascripts/calculator.js" defer></script>
