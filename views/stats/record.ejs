<link rel="stylesheet" href="/stylesheets/recordStyle.css" />
<div class="container mt-4">
    <h2 class="title">최근 6개월 CO₂ 배출량</h2>

    <div class="year_month">
        <!-- 연도 선택 드롭다운 -->
        <select id="yearSelect">
            <% for (let year = 2020; year <= 2030; year++) { %>
            <option value="<%= year %>"><%= year %>년</option>
            <% } %>
        </select>

        <!-- 월 선택 체크박스 -->
        <div class="row text-center month-selector" id="monthGrid">
            <% for (let month = 1; month <= 12; month++) { %>
            <div class="col-2">
                <div class="form-check">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="month<%= month %>"
                        value="<%= month %>"
                    />
                    <label class="form-check-label" for="month<%= month %>">
                        <%= month %>월
                    </label>
                </div>
            </div>
            <% } %>
        </div>
    </div>

    <!-- 차트 -->
    <div class="top1">
        <div class="chart-container">
            <canvas id="co2Chart_pie"></canvas>
        </div>
        <div class="row row-cols-4 g-3 monthCard-Container">
            <!-- 12개의 카드 반복 -->
            <% for (let month = 1; month <= 12; month++) { %>
            <div class="col">
                <div
                    class="card month-card text-center"
                    data-month="<%= month %>"
                    onclick="toggleCard(this)"
                >
                    <div class="card-body">
                        <h5 class="card-title"><%= month %>월</h5>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>
    <canvas id="co2Chart_bar" class="mt-3"></canvas>
</div>

<script type="module" src="/javascripts/record.js" defer></script>

