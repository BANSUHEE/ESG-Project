<link rel="stylesheet" href="/stylesheets/recordStyle.css" />
<h2 class="title">
    <select id="yearSelect">
        <% for (let year = 2020; year <= 2030; year++) { %>
            <option value="<%= year %>" <%= year == selectedYear ? "selected" : "" %>>
                <%= year %>년
            </option>
            <% } %>
    </select>
    온실가스 기록장
</h2>
<div class="container2">
    <!-- 연도 선택 드롭다운 -->

    <!-- 차트 -->
    <div class="box1">
        <div class="chart-container">
            <canvas id="co2Chart_pie"></canvas>
        </div>

        <div class="calendar">
            <!-- 월 선택 카드 -->
            <div class="monthCard-Container">
                <% for (let month = 1; month <= 12; month++) { %>
                <div
                    class="card month-card text-center"
                    data-month="<%= month %>"
                    onclick="selectMonthCard(this)"
                >
                    <div class="card-body">
                        <h5 class="card-title"><%= month %>월</h5>
                    </div>
                </div>
                <h5 class="card-total-co2" id="co2-month-<%= month %>">kg</h5>
                <% } %>
            </div>
        </div>
    </div>
    <div class="box2" >
        <div class="chart-bar-wrapper">
            <h2 class="title">6개월 배출량 변동 현황 </h2>
            <canvas id="co2Chart_bar" class="mt-3"></canvas>
        </div>
    </div>

    <div class="box3">
        <h3 id="co2-message-container"></h3>
        <h3 id="treeRequirementText"></h3>
        <table class="table table-bordered">
            <thead>
                <tr style=>
                    <th>나무 종류</th>
                    <th>1톤 CO₂당 필요 그루</th>
                    <th>필요 그루 수</th>
                </tr>
            </thead>
            <tbody id="treeRequirementTable">
                <!-- 나무 필요량 결과가 여기에 추가됩니다 -->
            </tbody>
        </table>
    </div>
</div>

<script type="module" src="/javascripts/record.js" defer></script>
<script type="module" src="/javascripts/tree.js" defer></script>
