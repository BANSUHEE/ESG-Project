<style>
    .month-selector {
        background-color: #f8fff8;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,150,0,0.1);
    }
    
    .form-check {
        text-align: center;
        margin: 5px;
    }
    
    .month-btn {
        width: 100%;
        padding: 10px;
        border: 2px solid #8bc34a;
        background-color: white;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }
    
    .month-btn input[type="checkbox"] {
        display: none;
    }
    
    .month-btn label {
        color: #689f38;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        margin: 0;
        padding: 8px 15px;
    }
    
    .month-btn:hover {
        background-color: #f1f8e9;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(139,195,74,0.2);
    }
    
    /* 체크된 상태 스타일 */
    .month-btn.checked {
        background-color: #8bc34a;
    }
    
    .month-btn.checked label {
        color: white;
    }
    </style>
    
<h2>최근 6개월 CO₂ 배출량</h2>
