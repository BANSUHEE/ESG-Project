<h2>Join</h2>
<form id="joinForm">
    <input type="text" id="name" name="name" placeholder="회사명" required />
    <input
        type="text"
        id="username"
        name="username"
        placeholder="Username"
        required
    />
    <input
        type="password"
        id="password"
        name="password"
        placeholder="Password"
        required
    />
    <input
        type="text"
        id="business_type"
        name="business_type"
        placeholder="업종"
        required
    />
    <input
        type="text"
        id="registration_number"
        name="registration_number"
        placeholder="사업자관리번호"
        required
    />
    <button type="submit">Join</button>
</form>
<p id="joinResult"></p>
<script src="/javascripts/join.js" defer></script>
