<style>
    .box {
        display: flex;
        justify-content: center;
        /* align-items: center; */
        /* height: 100vh; */
        margin: 0; /* 모든 여백 제거 */
    }

    .form-container {
        width: 100%;
        max-width: 400px;
        padding: 20px;
        margin: 0 auto; /* 중앙 정렬 */
        box-sizing: border-box; /* 패딩 포함한 크기 계산 */
    }

    .nav-tabs {
        margin-bottom: 20px;
    }

    .form-control {
        margin-bottom: 15px;
    }
</style>

<div class="box">
    <div class="form-container">
        <!-- 탭 네비게이션 -->
        <ul
            class="nav nav-tabs justify-content-center"
            id="userTypeTabs"
            role="tablist"
        >
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active"
                    id="personal-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#personalFields"
                    type="button"
                    role="tab"
                    aria-controls="personalFields"
                    aria-selected="true"
                >
                    기업 회원
                </button>
            </li>
        </ul>

        <!-- 탭 콘텐츠 -->
        <div class="tab-content">
            <div
                class="tab-pane fade show active"
                id="personalFields"
                role="tabpanel"
                aria-labelledby="personal-tab"
            >
                <form id="personalForm">
                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        placeholder="아이디"
                        required
                        value="abc"
                    />
                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="비밀번호"
                        required
                        value="0000"
                    />
                    <button type="submit" class="btn btn-secondary w-100">
                        기업 로그인
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/login.js" defer></script>
