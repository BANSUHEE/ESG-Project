<h2>Login</h2>
<form id="loginForm">
    <input
        type="text"
        id="username"
        name="username"
        placeholder="Username"
        required
    />
    <input
        type="password"
        id="password"
        name="password"
        placeholder="Password"
        required
    />
    <button type="submit">Login</button>
</form>
<p id="loginResult"></p>
<script src="/javascripts/login.js" defer></script>
