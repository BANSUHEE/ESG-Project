<style>
    .box {
        display: flex;
        justify-content: center;
        margin: 0;
    }

    .form-container {
        width: 100%;
        max-width: 400px;
        padding: 20px;
        margin: 0 auto;
        box-sizing: border-box;
    }

    .nav-tabs {
        margin-bottom: 20px;
    }

    .form-control {
        margin-bottom: 15px;
    }
</style>

<div class="box">
    <div class="form-container">
        <!-- 탭 네비게이션 -->
        <ul
            class="nav nav-tabs justify-content-center"
            id="userTypeTabs"
            role="tablist"
        >
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active"
                    id="personal-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#personalFields"
                    type="button"
                    role="tab"
                    aria-controls="personalFields"
                    aria-selected="true"
                >
                    개인 회원
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="company-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#companyFields"
                    type="button"
                    role="tab"
                    aria-controls="companyFields"
                    aria-selected="false"
                >
                    기업 회원
                </button>
            </li>
        </ul>

        <!-- 탭 콘텐츠 -->
        <div class="tab-content">
            <!-- 개인 회원 로그인 폼 -->
            <div
                class="tab-pane fade show active"
                id="personalFields"
                role="tabpanel"
                aria-labelledby="personal-tab"
            >
                <form id="personalForm">
                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        placeholder="아이디"
                        required
                        value=""
                    />
                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="비밀번호"
                        required
                        value=""
                    />
                    <button type="submit" class="btn btn-success w-100">
                        개인 로그인
                    </button>
                </form>
            </div>

            <!-- 기업 회원 로그인 폼 -->
            <div
                class="tab-pane fade"
                id="companyFields"
                role="tabpanel"
                aria-labelledby="company-tab"
            >
                <form id="companyForm">
                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        placeholder="아이디"
                        required
                        value=""
                    />
                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="비밀번호"
                        required
                        value=""
                    />
                    <button type="submit" class="btn btn-secondary w-100">
                        기업 로그인
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/login.js" defer></script>
